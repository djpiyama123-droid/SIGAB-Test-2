# SIGAB Monitor — configuración local (copia a .monitor.env y llena tus datos)
# Este archivo NO se sube a git

# Credenciales SIGAH (tu matrícula IMSS + contraseña del sistema)
SIGAH_MATRICULA=IMSS123456
SIGAH_PASSWORD=tu_contraseña

# VPS (dejar como está si no cambió)
VPS_HOST=129.121.100.147
SSH_ALIAS=root@129.121.100.147
# Clave SSH sin passphrase para automatización (opcional pero necesaria para Ollama via SSH)
# Genera con: ssh-keygen -t ed25519 -f ~/.ssh/id_sigab_monitor -N ""
# Instala con: ssh-copy-id -i ~/.ssh/id_sigab_monitor.pub root@129.121.100.147
SSH_KEY=~/.ssh/id_sigab_monitor

# Budget referencial (plan $20/mes = sin costo por token, solo informativo)
TOKEN_BUDGET_USD=20

# Repo GitHub público
GITHUB_REPO=djpiyama123-droid/SIGAB-Test-2
