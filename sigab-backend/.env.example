# ─────────────────────────────────────────────────────────────────────────────
# SIGAB Backend — Variables de entorno
# Copia este archivo a .env y ajusta los valores antes de arrancar.
# NUNCA versionar el .env real (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos MySQL ────────────────────────────────────────────────────
SIGAB_DB_HOST=127.0.0.1
SIGAB_DB_PORT=3306
SIGAB_DB_USER=sigab_user
SIGAB_DB_PASS=CAMBIAR_POR_PASS_SEGURO
SIGAB_DB_NAME=sigab

# ── JWT ────────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SIGAB_JWT_SECRET=CAMBIAR_POR_SECRETO_SEGURO_48_BYTES
SIGAB_JWT_ALG=HS256
SIGAB_ACCESS_TTL_MIN=60
SIGAB_REFRESH_TTL_DAYS=7

# ── Bot WhatsApp (sigab-bot / OpenClaw) ───────────────────────────────────
# JSON string con mapa slug→clave. Una clave por hospital.
# Generar claves con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# El slug debe coincidir exactamente con hospitales.slug en la base de datos.
BOT_API_KEYS={"hgr1-tijuana": "CAMBIAR_POR_CLAVE_SECRETA_HGR1"}

# ── Storage ────────────────────────────────────────────────────────────────
SIGAB_UPLOAD_DIR=./static/uploads

# ── URL pública (para QR) ─────────────────────────────────────────────────
SIGAB_PUBLIC_BASE_URL=http://localhost:5173

# ── SSL (false en producción HGR, true para deshabilitar en local) ─────────
SIGAB_SSL_DISABLED=true

# ── CORS extra (IPs LAN separadas por coma) ────────────────────────────────
SIGAB_CORS_EXTRA=

# ── IA local (Ollama) ─────────────────────────────────────────────────────
SIGAB_OLLAMA_HOST=http://localhost:11434
SIGAB_GEMMA_MODEL=gemma3:4b
SIGAB_QWEN_MODEL=qwen2.5:7b

# ── Router IA híbrido (Ollama local ↔ MiniMax nube) ──────────────────────
# ollama = on-premise (default, PHI nunca sale) | minimax = nube (agéntico)
SIGAH_LLM_PROVIDER=ollama
# 1 = si la nube falla, cae a Ollama local (resiliencia luz/nube)
SIGAH_LLM_FALLBACK_LOCAL=1
# Solo necesarias si SIGAH_LLM_PROVIDER=minimax (dejar vacío en on-premise).
# La clave es una sk-api de MiniMax (NUNCA commitear una clave real).
SIGAH_MINIMAX_API_KEY=
SIGAH_MINIMAX_BASE_URL=https://api.minimax.io/v1
SIGAH_MINIMAX_MODEL=MiniMax-M3
SIGAH_MINIMAX_TIMEOUT=60

# ── OCR / Gemini ─────────────────────────────────────────────────────────
SIGAB_OCR_CONFIDENCE=0.85
SIGAB_OCR_MIN_WORDS=5
SIGAB_GEMINI_API_KEY=CAMBIAR_POR_API_KEY_GEMINI

# ── Feature flags ────────────────────────────────────────────────────────
# Poner 1 para deshabilitar el Copilot (ahorra RAM si no se usa IA local)
SIGAB_DISABLE_COPILOT=0
