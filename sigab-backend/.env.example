# ─────────────────────────────────────────────────────────────────────────────
# SIGAH/SIGAB Backend — Variables de entorno
# Copia este archivo a .env y ajusta los valores antes de arrancar.
# NUNCA versionar el .env real (está en .gitignore).
#
# IMPORTANTE: el backend lee variables con prefijo SIGAH_ (no SIGAB_).
# ─────────────────────────────────────────────────────────────────────────────

# ── Entorno ────────────────────────────────────────────────────────────────
# development | production. En production los secretos son OBLIGATORIOS:
# el backend NO arranca si falta SIGAH_DB_PASS o SIGAH_JWT_SECRET.
SIGAH_ENV=development

# ── Base de datos MySQL ────────────────────────────────────────────────────
SIGAH_DB_HOST=127.0.0.1
SIGAH_DB_PORT=3306
SIGAH_DB_USER=sigah_user
SIGAH_DB_PASS=CAMBIAR_POR_PASS_SEGURO
SIGAH_DB_NAME=sigah

# ── JWT ────────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SIGAH_JWT_SECRET=CAMBIAR_POR_SECRETO_SEGURO_48_BYTES
SIGAH_JWT_ALG=HS256
SIGAH_ACCESS_TTL_MIN=60
SIGAH_REFRESH_TTL_DAYS=7

# ── Bot WhatsApp (sigab-bot / OpenClaw) ───────────────────────────────────
# JSON string con mapa slug→clave. Una clave por hospital.
# Generar claves con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# El slug debe coincidir exactamente con hospitales.slug en la base de datos.
BOT_API_KEYS={"hgr1-tijuana": "CAMBIAR_POR_CLAVE_SECRETA_HGR1"}

# ── Storage ────────────────────────────────────────────────────────────────
SIGAH_UPLOAD_DIR=./static/uploads

# ── URL pública (para QR) ─────────────────────────────────────────────────
SIGAH_PUBLIC_BASE_URL=http://localhost:5173

# ── SSL (false en producción HGR, true para deshabilitar en local) ─────────
SIGAH_SSL_DISABLED=true

# ── CORS extra (orígenes/IPs LAN separados por coma) ───────────────────────
# Ej: SIGAH_CORS_EXTRA=http://192.168.1.125:5173,http://192.168.1.125:5174
SIGAH_CORS_EXTRA=

# ── IA local (Ollama) ─────────────────────────────────────────────────────
SIGAH_OLLAMA_HOST=http://localhost:11434
SIGAH_GEMMA_MODEL=gemma3:4b
SIGAH_QWEN_MODEL=qwen2.5:7b

# ── OCR / Gemini ─────────────────────────────────────────────────────────
SIGAH_OCR_CONFIDENCE=0.85
SIGAH_OCR_MIN_WORDS=5
SIGAH_GEMINI_API_KEY=CAMBIAR_POR_API_KEY_GEMINI

# ── Feature flags ────────────────────────────────────────────────────────
# Poner 1 para deshabilitar el Copilot (ahorra RAM si no se usa IA local)
SIGAH_DISABLE_COPILOT=0
