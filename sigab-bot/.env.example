# sigab-bot — Variables de entorno
# Copiar a .env y rellenar los valores reales

# URL del backend SIGAH (default: http://localhost:8000)
SIGAB_BACKEND_URL=http://localhost:8000

# Clave de autenticación del bot para el hospital
# Debe coincidir con el valor de BOT_API_KEYS en el backend (.env del servidor)
# Formato backend: BOT_API_KEYS={"hgr1-tijuana": "ESTA_MISMA_CLAVE"}
BOT_API_KEY=CAMBIAR_POR_CLAVE_SECRETA_HGR1

# Puerto del servidor Express interno del bot
BOT_PORT=3000

# URL del webhook FastAPI para eventos WhatsApp
WHATSAPP_WEBHOOK_URL=http://localhost:8000/api/events/whatsapp/webhook
